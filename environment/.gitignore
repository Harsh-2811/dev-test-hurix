# Node dependencies
node_modules/

# DuckDB database files and write-ahead logs
releases.duckdb
*.duckdb
*.duckdb.wal

# Generated report output written by the publisher at runtime.
# The committed golden lives at reports/publications.expected.txt and stays tracked.
reports/publications.actual.txt
/publications.actual.txt

# Distribution gateway runtime ledger (keep the .gitkeep placeholder tracked)
distribution-gateway/data/*.json
distribution-gateway/data/*.db
!distribution-gateway/data/.gitkeep

# Lockfiles are deliberately not shipped: the Dockerfile uses `npm install`
# against exact version pins (npm ci would require a lockfile).
package-lock.json
distribution-gateway/package-lock.json

# Build-time signing keys are generated inside the image, not in this tree.
# Guarded anyway: a private key must never be committed.
*.pem
keys/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
